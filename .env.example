VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_DATABASE_ID=your_database_id_here

# Firebase Cloud Messaging - Push Notifications (VAPID Key)
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# Firebase Functions region (must match the region used for deployment)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Firebase App Check (reCAPTCHA Enterprise score-based site key). This key is
# public by design. Use a registered debug token only for local development.
VITE_FIREBASE_APPCHECK_SITE_KEY=your_recaptcha_enterprise_site_key_here
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional TURN server for WebRTC calls. Separate multiple UDP/TCP/TLS URLs
# with commas so restrictive Wi-Fi can fall back to TURN over TLS/443.
# These values are bundled into the browser: use only short-lived credentials in
# production. Calls can still work over the public STUN servers without them.
VITE_TURN_URL=turn:your-turn-host:3478?transport=udp,turn:your-turn-host:443?transport=tcp,turns:your-turn-host:443?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Google Drive API (pick and preview one user-selected file at a time)
VITE_GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
# Numeric Google Cloud project number used by Google Picker. If omitted, the
# app tries to infer it from the OAuth client ID.
VITE_GOOGLE_DRIVE_APP_ID=your_google_cloud_project_number_here
VITE_GOOGLE_DRIVE_FOLDER_ID=1tVg-LCvByThY6B7zAuQc4kujxv4Fz0-D
